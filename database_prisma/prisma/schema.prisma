// ════════════════════════════════════════════════════════════════
// VENDEAI BOT SYSTEM - DATABASE SCHEMA
// PostgreSQL + Prisma ORM
// ════════════════════════════════════════════════════════════════
//
// FEATURES:
// - Multi-tenant architecture
// - Soft deletes
// - Automatic timestamps
// - JSON fields for flexibility
// - Optimized indexes
// - LGPD compliance
//
// ════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════
// EMPRESAS (MULTI-TENANT)
// ════════════════════════════════════════════════════════════════

model Empresa {
  id                  Int       @id @default(autoincrement())
  nome                String    @db.VarChar(255)
  cnpj                String?   @unique @db.VarChar(18)
  endereco            String?   @db.Text
  telefone            String?   @db.VarChar(20)
  email               String?   @db.VarChar(255)
  logo_url            String?   @db.Text

  // Configuração do WhatsApp
  whatsapp_numero     String?   @db.VarChar(20)
  whatsapp_conectado  Boolean   @default(false)

  // Nicho de negócio
  nicho               String    @default("veiculos") @db.VarChar(50) // veiculos, imoveis, servicos, etc

  // Status
  ativo               Boolean   @default(true)
  bot_ativo           Boolean   @default(false)

  // Plano e limites
  plano               String    @default("free") @db.VarChar(50) // free, basic, pro, enterprise
  limite_mensagens    Int       @default(1000)
  limite_usuarios     Int       @default(5)

  // Timestamps
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  // Relacionamentos
  usuarios            User[]
  configuracoes       BotConfiguration[]
  mensagens_automaticas AutomatedMessage[]
  horarios            BusinessHours[]
  comportamentos      BotBehavior[]
  veiculos            Vehicle[]
  conversas           Conversation[]
  agendamentos        Appointment[]
  integracoes         Integration[]
  conhecimento        KnowledgeBase[]
  metricas            AnalyticsMetric[]
  logs_auditoria      AuditLog[]

  @@index([cnpj])
  @@index([whatsapp_numero])
  @@index([ativo, bot_ativo])
  @@map("empresas")
}

// ════════════════════════════════════════════════════════════════
// USUÁRIOS DO SISTEMA
// ════════════════════════════════════════════════════════════════

model User {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int

  // Dados pessoais
  nome                String    @db.VarChar(255)
  email               String    @unique @db.VarChar(255)
  senha_hash          String    @db.VarChar(255)
  telefone            String?   @db.VarChar(20)
  avatar_url          String?   @db.Text

  // Tipo e permissões
  tipo                String    @default("vendedor") @db.VarChar(50) // admin, vendedor, gestor
  permissoes          Json?     // Permissões customizadas

  // Status
  ativo               Boolean   @default(true)
  ultimo_acesso       DateTime?

  // Timestamps
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  // Relacionamentos
  empresa             Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  conversas_atribuidas Conversation[]
  agendamentos        Appointment[]
  logs_criados        AuditLog[] @relation("UserCreated")

  @@index([empresa_id])
  @@index([email])
  @@index([tipo])
  @@map("users")
}

// ════════════════════════════════════════════════════════════════
// CONFIGURAÇÕES DO BOT
// ════════════════════════════════════════════════════════════════

model BotConfiguration {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int

  // Personalidade do bot
  nome_bot            String    @default("AIra") @db.VarChar(100)
  saudacao            String    @db.Text
  despedida           String?   @db.Text
  tom_conversa        String    @default("profissional_amigavel") @db.VarChar(50) // formal, informal, profissional_amigavel

  // Comportamento
  auto_resposta_ativa Boolean   @default(true)
  tempo_resposta_ms   Int       @default(2000)
  max_tentativas_ia   Int       @default(3)

  // IA e Processamento
  modelo_ia           String    @default("claude-3-sonnet") @db.VarChar(100)
  temperatura         Float     @default(0.7)
  max_tokens          Int       @default(4096)

  // Audio
  enviar_audio        Boolean   @default(false)
  voz_id              String?   @db.VarChar(100) // ElevenLabs voice ID

  // Funcionalidades
  funcionalidades     Json      // { busca_veiculos: true, agendamento: true, fipe: true, etc }

  // Limites
  max_mensagens_dia   Int       @default(100)
  intervalo_mensagens_ms Int    @default(1000)

  // Timestamps
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Relacionamentos
  empresa             Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@unique([empresa_id]) // Uma configuração por empresa
  @@map("bot_configurations")
}

// ════════════════════════════════════════════════════════════════
// MENSAGENS AUTOMÁTICAS
// ════════════════════════════════════════════════════════════════

model AutomatedMessage {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int

  // Identificação
  tipo                String    @db.VarChar(50) // boas_vindas, fora_horario, primeira_mensagem, etc
  nome                String    @db.VarChar(255)
  descricao           String?   @db.Text

  // Conteúdo
  mensagem            String    @db.Text
  variaveis           Json?     // Variáveis disponíveis: {nome}, {empresa}, etc

  // Condições de disparo
  trigger_evento      String?   @db.VarChar(100) // primeiro_contato, apos_5min_inativo, etc
  trigger_condicao    Json?     // Condições complexas

  // Configurações
  ativo               Boolean   @default(true)
  prioridade          Int       @default(0)
  delay_ms            Int       @default(0)

  // Timestamps
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  // Relacionamentos
  empresa             Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@index([empresa_id])
  @@index([tipo])
  @@index([ativo])
  @@map("automated_messages")
}

// ════════════════════════════════════════════════════════════════
// HORÁRIOS DE FUNCIONAMENTO
// ════════════════════════════════════════════════════════════════

model BusinessHours {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int

  // Dia da semana (0 = domingo, 6 = sábado)
  dia_semana          Int       @db.SmallInt

  // Horários
  horario_inicio      String    @db.VarChar(5) // HH:MM
  horario_fim         String    @db.VarChar(5) // HH:MM

  // Status
  ativo               Boolean   @default(true)

  // Mensagem personalizada fora do horário
  mensagem_fora_horario String? @db.Text

  // Timestamps
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Relacionamentos
  empresa             Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@unique([empresa_id, dia_semana])
  @@index([empresa_id])
  @@map("business_hours")
}

// ════════════════════════════════════════════════════════════════
// REGRAS DE COMPORTAMENTO DO BOT
// ════════════════════════════════════════════════════════════════

model BotBehavior {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int

  // Identificação da regra
  nome                String    @db.VarChar(255)
  descricao           String?   @db.Text
  categoria           String    @db.VarChar(100) // vendas, atendimento, follow_up, etc

  // Condição
  condicao_trigger    Json      // { tipo: 'palavra_chave', valores: ['preço', 'valor'] }

  // Ação
  acao_tipo           String    @db.VarChar(100) // enviar_mensagem, transferir_vendedor, criar_lead, etc
  acao_parametros     Json      // Parâmetros da ação

  // Prioridade e validação
  prioridade          Int       @default(0)
  ativo               Boolean   @default(true)

  // Estatísticas
  vezes_executado     Int       @default(0)
  ultima_execucao     DateTime?

  // Timestamps
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  // Relacionamentos
  empresa             Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@index([empresa_id])
  @@index([categoria])
  @@index([ativo])
  @@map("bot_behaviors")
}

// ════════════════════════════════════════════════════════════════
// VEÍCULOS (ESTOQUE)
// ════════════════════════════════════════════════════════════════

model Vehicle {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int

  // Dados básicos
  marca               String    @db.VarChar(100)
  modelo              String    @db.VarChar(255)
  ano                 Int
  cor                 String?   @db.VarChar(50)

  // Detalhes técnicos
  kilometragem        Int?
  combustivel         String?   @db.VarChar(50) // gasolina, diesel, flex, eletrico, hibrido
  cambio              String?   @db.VarChar(50) // manual, automatico, automatizado
  motor               String?   @db.VarChar(50)
  portas              Int?      @db.SmallInt

  // Financeiro
  preco               Decimal   @db.Decimal(10, 2)
  preco_fipe          Decimal?  @db.Decimal(10, 2)
  aceita_troca        Boolean   @default(false)

  // Descrição e mídia
  descricao           String?   @db.Text
  fotos_urls          Json?     // Array de URLs das fotos
  video_url           String?   @db.Text

  // Localização
  placa               String?   @db.VarChar(10)
  chassi              String?   @db.VarChar(20)
  renavam             String?   @db.VarChar(15)

  // Status
  status              String    @default("disponivel") @db.VarChar(50) // disponivel, vendido, reservado
  destaque            Boolean   @default(false)

  // Dados adicionais (flexível)
  caracteristicas     Json?     // { ar_condicionado: true, direcao_hidraulica: true, etc }

  // Timestamps
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  // Relacionamentos
  empresa             Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  conversas           ConversationContext[] @relation("VehicleInterest")

  @@index([empresa_id])
  @@index([marca, modelo])
  @@index([status])
  @@index([preco])
  @@index([ano])
  @@fulltext([marca, modelo, descricao])
  @@map("vehicles")
}

// ════════════════════════════════════════════════════════════════
// CONVERSAS
// ════════════════════════════════════════════════════════════════

model Conversation {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int

  // Cliente
  cliente_telefone    String    @db.VarChar(20)
  cliente_nome        String?   @db.VarChar(255)
  cliente_email       String?   @db.VarChar(255)

  // Status da conversa
  status              String    @default("ativa") @db.VarChar(50) // ativa, finalizada, abandonada, convertida
  etapa               String    @default("inicial") @db.VarChar(100) // inicial, descoberta, apresentacao, negociacao, fechamento

  // Atribuição
  vendedor_id         Int?

  // Métricas
  total_mensagens     Int       @default(0)
  tempo_resposta_medio_ms Int?
  temperatura_lead    Int       @default(0) // 0-100
  probabilidade_fechamento Int  @default(0) // 0-100

  // Timestamps importantes
  primeira_mensagem   DateTime  @default(now())
  ultima_mensagem     DateTime  @default(now())
  finalizada_em       DateTime?

  // Timestamps
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  // Relacionamentos
  empresa             Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  vendedor            User?     @relation(fields: [vendedor_id], references: [id], onDelete: SetNull)
  mensagens           Message[]
  contexto            ConversationContext?
  agendamentos        Appointment[]

  @@index([empresa_id])
  @@index([cliente_telefone])
  @@index([status])
  @@index([vendedor_id])
  @@index([ultima_mensagem])
  @@map("conversations")
}

// ════════════════════════════════════════════════════════════════
// MENSAGENS
// ════════════════════════════════════════════════════════════════

model Message {
  id                  Int       @id @default(autoincrement())
  conversa_id         Int

  // Origem
  remetente_tipo      String    @db.VarChar(50) // cliente, bot, vendedor
  remetente_nome      String?   @db.VarChar(255)

  // Conteúdo
  tipo_mensagem       String    @db.VarChar(50) // texto, imagem, audio, video, documento
  conteudo            String    @db.Text
  midia_url           String?   @db.Text

  // Metadados
  whatsapp_message_id String?   @db.VarChar(255)
  metadata            Json?     // Dados adicionais da mensagem

  // IA e Análise
  intencao            String?   @db.VarChar(100) // buscar_veiculo, agendar, negociar, duvida
  sentimento          String?   @db.VarChar(50) // positivo, neutro, negativo
  entidades_extraidas Json?     // { veiculos: [...], valores: [...], datas: [...] }

  // Status
  lida                Boolean   @default(false)
  erro                Boolean   @default(false)
  erro_mensagem       String?   @db.Text

  // Timestamps
  enviada_em          DateTime  @default(now())
  lida_em             DateTime?

  // Relacionamentos
  conversa            Conversation @relation(fields: [conversa_id], references: [id], onDelete: Cascade)

  @@index([conversa_id])
  @@index([remetente_tipo])
  @@index([enviada_em])
  @@index([whatsapp_message_id])
  @@fulltext([conteudo])
  @@map("messages")
}

// ════════════════════════════════════════════════════════════════
// CONTEXTO DA CONVERSA
// ════════════════════════════════════════════════════════════════

model ConversationContext {
  id                  Int       @id @default(autoincrement())
  conversa_id         Int       @unique

  // Interesses e preferências
  veiculos_interesse  Int[]     // IDs dos veículos de interesse
  veiculo_principal_id Int?

  // Orçamento e condições
  orcamento_min       Decimal?  @db.Decimal(10, 2)
  orcamento_max       Decimal?  @db.Decimal(10, 2)
  forma_pagamento     String?   @db.VarChar(100) // a_vista, financiamento, consorcio
  valor_entrada       Decimal?  @db.Decimal(10, 2)

  // Veículo de troca
  tem_veiculo_troca   Boolean   @default(false)
  troca_marca         String?   @db.VarChar(100)
  troca_modelo        String?   @db.VarChar(255)
  troca_ano           Int?
  troca_valor_fipe    Decimal?  @db.Decimal(10, 2)

  // Preferências
  preferencias        Json?     // { cor: 'preto', cambio: 'automatico', etc }
  objecoes            Json?     // Array de objeções levantadas

  // Análise IA
  resumo_conversa     String?   @db.Text
  perfil_cliente      String?   @db.VarChar(100) // indeciso, decidido, pesquisador, negociador
  proximos_passos     Json?     // Array de próximas ações sugeridas

  // Histórico de interações
  historico_resumido  Json?     // Resumo das últimas interações

  // Timestamps
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Relacionamentos
  conversa            Conversation @relation(fields: [conversa_id], references: [id], onDelete: Cascade)
  veiculo_principal   Vehicle?  @relation("VehicleInterest", fields: [veiculo_principal_id], references: [id], onDelete: SetNull)

  @@index([conversa_id])
  @@index([veiculo_principal_id])
  @@map("conversation_contexts")
}

// ════════════════════════════════════════════════════════════════
// AGENDAMENTOS
// ════════════════════════════════════════════════════════════════

model Appointment {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int
  conversa_id         Int?

  // Cliente
  cliente_nome        String    @db.VarChar(255)
  cliente_telefone    String    @db.VarChar(20)
  cliente_email       String?   @db.VarChar(255)

  // Agendamento
  tipo                String    @db.VarChar(100) // test_drive, visita, avaliacao_troca
  data_hora           DateTime
  duracao_minutos     Int       @default(30)

  // Vendedor responsável
  vendedor_id         Int?

  // Local
  local               String?   @db.Text
  observacoes         String?   @db.Text

  // Status
  status              String    @default("agendado") @db.VarChar(50) // agendado, confirmado, realizado, cancelado, nao_compareceu

  // Notificações
  notificado_cliente  Boolean   @default(false)
  notificado_vendedor Boolean   @default(false)
  lembrete_enviado    Boolean   @default(false)

  // Resultado
  compareceu          Boolean?
  notas_pos_visita    String?   @db.Text

  // Timestamps
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  // Relacionamentos
  empresa             Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  conversa            Conversation? @relation(fields: [conversa_id], references: [id], onDelete: SetNull)
  vendedor            User?     @relation(fields: [vendedor_id], references: [id], onDelete: SetNull)

  @@index([empresa_id])
  @@index([data_hora])
  @@index([status])
  @@index([vendedor_id])
  @@map("appointments")
}

// ════════════════════════════════════════════════════════════════
// INTEGRAÇÕES
// ════════════════════════════════════════════════════════════════

model Integration {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int

  // Tipo de integração
  tipo                String    @db.VarChar(100) // whatsapp, mercadopago, elevenlabs, fipe, etc
  nome                String    @db.VarChar(255)

  // Configurações (CRIPTOGRAFADO)
  config              Json      // { api_key: 'encrypted...', webhook_url: '...', etc }

  // Status
  ativo               Boolean   @default(true)
  conectado           Boolean   @default(false)
  ultima_verificacao  DateTime?

  // Estatísticas
  total_requisicoes   Int       @default(0)
  total_erros         Int       @default(0)
  ultima_requisicao   DateTime?
  ultimo_erro         DateTime?

  // Timestamps
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  // Relacionamentos
  empresa             Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@unique([empresa_id, tipo])
  @@index([empresa_id])
  @@index([tipo])
  @@map("integrations")
}

// ════════════════════════════════════════════════════════════════
// BASE DE CONHECIMENTO / FAQ
// ════════════════════════════════════════════════════════════════

model KnowledgeBase {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int

  // Organização
  categoria           String    @db.VarChar(100) // financiamento, garantia, documentacao, etc
  titulo              String    @db.VarChar(255)

  // Conteúdo
  pergunta            String    @db.Text
  resposta            String    @db.Text
  palavras_chave      String[]  // Array de palavras-chave para busca

  // Uso
  vezes_usado         Int       @default(0)
  ultima_utilizacao   DateTime?
  relevancia_score    Float     @default(0)

  // Status
  ativo               Boolean   @default(true)

  // Timestamps
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  // Relacionamentos
  empresa             Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@index([empresa_id])
  @@index([categoria])
  @@index([ativo])
  @@fulltext([titulo, pergunta, resposta])
  @@map("knowledge_base")
}

// ════════════════════════════════════════════════════════════════
// MÉTRICAS E ANALYTICS
// ════════════════════════════════════════════════════════════════

model AnalyticsMetric {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int

  // Período
  data                DateTime  @db.Date
  hora                Int?      @db.SmallInt // 0-23 (null = dia completo)

  // Métricas de conversas
  conversas_iniciadas Int       @default(0)
  conversas_finalizadas Int     @default(0)
  conversas_convertidas Int     @default(0)

  // Métricas de mensagens
  mensagens_enviadas  Int       @default(0)
  mensagens_recebidas Int       @default(0)
  tempo_resposta_medio_ms Int?

  // Métricas de vendas
  leads_gerados       Int       @default(0)
  test_drives_agendados Int     @default(0)
  veiculos_vendidos   Int       @default(0)
  valor_total_vendas  Decimal?  @db.Decimal(12, 2)

  // Métricas de satisfação
  satisfacao_media    Float?
  nps_score           Int?

  // Métricas de IA
  queries_ia          Int       @default(0)
  custo_ia_usd        Decimal?  @db.Decimal(10, 4)

  // Timestamps
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  // Relacionamentos
  empresa             Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@unique([empresa_id, data, hora])
  @@index([empresa_id, data])
  @@map("analytics_metrics")
}

// ════════════════════════════════════════════════════════════════
// LOGS DE AUDITORIA
// ════════════════════════════════════════════════════════════════

model AuditLog {
  id                  Int       @id @default(autoincrement())
  empresa_id          Int

  // Ação realizada
  acao                String    @db.VarChar(100) // create, update, delete, login, etc
  entidade_tipo       String    @db.VarChar(100) // Vehicle, User, Conversation, etc
  entidade_id         Int?

  // Usuário que realizou a ação
  usuario_id          Int?
  usuario_ip          String?   @db.VarChar(45)
  user_agent          String?   @db.Text

  // Dados
  dados_anteriores    Json?     // Estado anterior (para updates e deletes)
  dados_novos         Json?     // Novo estado (para creates e updates)

  // Metadados
  descricao           String?   @db.Text

  // Timestamp
  created_at          DateTime  @default(now())

  // Relacionamentos
  empresa             Empresa   @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  usuario             User?     @relation("UserCreated", fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([empresa_id])
  @@index([created_at])
  @@index([acao])
  @@index([entidade_tipo, entidade_id])
  @@map("audit_logs")
}
