# ════════════════════════════════════════════════════════════════
# VENDEAI BOT SYSTEM - DATABASE CONFIGURATION
# ════════════════════════════════════════════════════════════════

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/vendeai_db?schema=public"

# Optional: Shadow database for migrations (recommended for production)
# SHADOW_DATABASE_URL="postgresql://postgres:password@localhost:5432/vendeai_shadow?schema=public"

# ════════════════════════════════════════════════════════════════
# ENCRYPTION (for sensitive data)
# ════════════════════════════════════════════════════════════════

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="your-32-character-encryption-key-here"

# ════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ════════════════════════════════════════════════════════════════

NODE_ENV="development" # development | production | test

# ════════════════════════════════════════════════════════════════
# EXTERNAL SERVICES (for seed data testing)
# ════════════════════════════════════════════════════════════════

# Anthropic Claude API
ANTHROPIC_API_KEY="sk-ant-..."

# ElevenLabs TTS
ELEVENLABS_API_KEY="..."

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN="..."
